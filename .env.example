# ---------- LLM ----------
# "groq" (free tier API) or "ollama" (100% local, e.g. real Llama 3)
LLM_PROVIDER=groq

# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=
# Comma-separated preference list. The first model your key can actually use wins.
# (Groq retired Llama 3.x on the free tier in Aug 2026; gpt-oss is open-weight.)
GROQ_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b,llama-3.3-70b-versatile,llama-3.1-8b-instant

# Only used when LLM_PROVIDER=ollama   (ollama pull llama3.1:8b)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# ---------- Graph ----------
# "networkx" (zero install) or "neo4j" (Neo4j Desktop / Docker, Community Edition)
GRAPH_BACKEND=neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password123
NEO4J_DATABASE=neo4j

# ---------- Embeddings ----------
EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ---------- Retrieval ----------
TOP_K_CHUNKS=4
TOP_K_ENTITIES=6
GRAPH_HOPS=2
MAX_FACTS=60
